{
  "name": "promo-video",
  "version": "1.0.0",
  "description": "Automic Vault product promo Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.451",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.451"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.451",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render AutomicVaultPromo out/automic-vault-promo.mp4 --muted",
    "render:skill-secrets": "remotion render AutomicVaultSkillSecrets out/automic-vault-skill-secrets.mp4 --muted",
    "render:brew-install-security": "remotion render AutomicVaultBrewInstallSecurity out/automic-vault-brew-install-security.mp4 --muted",
    "render:scanner-one-liner": "remotion render AutomicVaultScannerOneLiner out/automic-vault-scanner-one-liner.mp4 --muted",
    "render:dont-get-owned": "remotion render AutomicVaultDontGetOwned out/automic-vault-dont-get-owned.mp4 --muted",
    "render:readme-loop": "remotion render AutomicVaultReadmeLoop out/readme-loop.mp4 --muted",
    "render:readme-loop:gif": "remotion render AutomicVaultReadmeLoop out/readme-loop.mp4 --muted && ffmpeg -y -i out/readme-loop.mp4 -vf \"fps=15,scale=1000:-1:flags=lanczos,palettegen=max_colors=80:stats_mode=full\" out/palette.png && ffmpeg -y -i out/readme-loop.mp4 -i out/palette.png -lavfi \"fps=15,scale=1000:-1:flags=lanczos[x];[x][1:v]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle\" -loop 0 ../../assets/readme-loop.gif",
    "still": "remotion still AutomicVaultPromo",
    "still:skill-secrets": "remotion still AutomicVaultSkillSecrets",
    "still:brew-install-security": "remotion still AutomicVaultBrewInstallSecurity",
    "still:scanner-one-liner": "remotion still AutomicVaultScannerOneLiner",
    "still:dont-get-owned": "remotion still AutomicVaultDontGetOwned",
    "still:readme-loop": "remotion still AutomicVaultReadmeLoop",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
